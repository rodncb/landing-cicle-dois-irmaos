# Cicle Dois Irmãos — landing page (Hostinger / Apache + LiteSpeed)
# Equivalente ao _headers do Cloudflare.

# ---------- HTTPS + domínio canônico (sem www) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------- Cabeçalhos de segurança ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # assets versionados por nome: cache longo
  <FilesMatch "\.(woff2|png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # o HTML precisa revalidar para a próxima publicação chegar na hora
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------- Compressão ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ---------- Tipos ----------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

# ---------- Página de erro ----------
ErrorDocument 404 /index.html

# arquivos internos do repositório (documentação) não ficam públicos
<FilesMatch "\.(md|gitignore)$|^_headers$">
  Require all denied
</FilesMatch>

# não listar diretórios
Options -Indexes
